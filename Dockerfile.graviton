# syntax=docker/dockerfile:1.4
# Stage 1: Build OpenCV 5 with KleidiCV ARM64 optimizations
FROM --platform=linux/arm64 ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV CMAKE_BUILD_PARALLEL_LEVEL=8

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ca-certificates \
    python3-dev \
    python3-pip \
    python3-numpy \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libopenblas-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/build

# Clone OpenCV 5 and Contrib modules
RUN git clone --depth 1 --branch 5.x [https://github.com/opencv/opencv.git](https://github.com/opencv/opencv.git) && \
    git clone --depth 1 --branch 5.x [https://github.com/opencv/opencv_contrib.git](https://github.com/opencv/opencv_contrib.git)

# Clone KleidiCV (Arm-optimized computer vision kernels)
RUN git clone --depth 1 [https://git.gitlab.arm.com/kleidi/kleidicv.git](https://git.gitlab.arm.com/kleidi/kleidicv.git) /opt/build/kleidicv

WORKDIR /opt/build/opencv/build

# CMake configuration tuned for AWS Graviton (ARM64 + NEON + KleidiCV HAL)
RUN cmake \
    -D CMAKE_BUILD_TYPE=RELEASE \
    -D CMAKE_INSTALL_PREFIX=/opt/cool/opencv5 \
    -D OPENCV_EXTRA_MODULES_PATH=/opt/build/opencv_contrib/modules \
    -D WITH_KLEIDICV=ON \
    -D KLEIDICV_LOCATION=/opt/build/kleidicv \
    -D ENABLE_NEON=ON \
    -D CPU_BASELINE=NEON \
    -D CPU_DISPATCH=NEON,FP16 \
    -D WITH_OPENBLAS=ON \
    -D WITH_TBB=OFF \
    -D WITH_IPP=OFF \
    -D WITH_1394=OFF \
    -D WITH_CUDA=OFF \
    -D BUILD_opencv_python3=ON \
    -D PYTHON3_EXECUTABLE=/usr/bin/python3 \
    -D PYTHON3_LIBRARY=$(python3 -c "import sysconfig; print(sysconfig.get_config_var('LIBDIR'))")/libpython3.12.so \
    -D PYTHON3_INCLUDE_DIR=/usr/include/python3.12 \
    -D BUILD_TESTS=OFF \
    -D BUILD_PERF_TESTS=OFF \
    -D BUILD_EXAMPLES=OFF \
    -D BUILD_DOCS=OFF \
    .. && \
    make -j$(nproc) && \
    make install

# Stage 2: Minimal Graviton runtime image
FROM --platform=linux/arm64 ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/opt/cool/opencv5/lib/python3.12/site-packages:${PYTHONPATH}"
ENV LD_LIBRARY_PATH="/opt/cool/opencv5/lib:${LD_LIBRARY_PATH}"

# Install minimal runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libopenblas0 \
    libjpeg8 \
    libpng16-16t64 \
    libavcodec60 \
    libavformat60 \
    libswscale7 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy built OpenCV 5 + COOL binaries from builder
COPY --from=builder /opt/cool/opencv5 /opt/cool/opencv5

WORKDIR /app

# Install AWS SDK and scientific dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

# Copy perception tool engines and entrypoint
COPY src/ /app/src/

ENTRYPOINT ["python3", "-m", "src.entrypoint"]
